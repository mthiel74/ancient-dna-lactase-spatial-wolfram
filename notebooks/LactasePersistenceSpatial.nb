Notebook[{

Cell[CellGroupData[{
Cell["Lactase persistence: data walkthrough", "Title",ExpressionUUID->"6c6c5860-3d8b-4a97-981e-0156b8d5f612"],

Cell["\<\
Load the package, retrieve the public GLAD ancient rs4988235 workbook, and \
reproduce the regional frequency curves. The full spatial SMC-ABC analysis, \
validation, and animation live in \
community/ancient_dna_lactase_persistence.nb.\
\>", "Subtitle",ExpressionUUID->"b3dba15b-9624-494b-a87f-80c313638247"],

Cell[CellGroupData[{

Cell["1.  Setup", "Section",ExpressionUUID->"e06c7ef1-b5f1-4832-92e1-c1f55fc5708c"],

Cell["\<\
The setup cell finds the companion package next to this notebook or in src/ \
of the cloned repository, and anchors all paths at that folder.\
\>", "Text",ExpressionUUID->"b85f99c5-a99a-40d2-8830-f0e31f23110b"],

Cell["\<\
nbdir = NotebookDirectory[];
root = If[FileExistsQ[FileNameJoin[{ParentDirectory[nbdir], \"src\", \
\"LactasePersistenceSpatial.wl\"}]],
   ParentDirectory[nbdir], nbdir];
SetDirectory[root];
Get[First[Select[
   {FileNameJoin[{root, \"src\", \"LactasePersistenceSpatial.wl\"}],
    FileNameJoin[{nbdir, \"LactasePersistenceSpatial.wl\"}]}, FileExistsQ]]];\
\
\>", "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"954a338a-37cd-4516-9ead-53091d0a3b51"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2.  Data", "Section",ExpressionUUID->"8a8adc36-5702-4fba-acaf-b0d3dd149391"],

Cell["\<\
Download (once, with checksum and provenance) and parse the workbook: 2,999 \
rows; kept are the samples with a genotype call at rs4988235 plus usable age \
and coordinates. A and strand-flipped T count as derived, G/C as ancestral; \
pseudo-haploid calls contribute one allele.\
\>", "Text",ExpressionUUID->"e08d02f5-4953-40fc-a7e6-92cf4b76a077"],

Cell[CellGroupData[{

Cell["\<\
raw = RetrieveRawData[Directory[]];
processed = WriteProcessedData[Directory[], raw];
samples = processed[\"CalledSamples\"];
Length[samples]\
\>", "Input",
 CellLabel->"In[2]:=",ExpressionUUID->"726301c9-1a80-4e91-97b6-127b738d38ba"],

Cell[BoxData["1785"], "Output",
 CellLabel->"Out[2]=",ExpressionUUID->"d3672ab9-839b-497e-89be-5e88186a6429"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Counts[#[\"Region\"] & /@ samples]", "Input",
 CellLabel->"In[3]:=",ExpressionUUID->"d5bed782-7e5c-4cc7-b486-48ed04bd058a"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Rhine-Danube\"\>", "\[Rule]", "341"}], ",", 
   RowBox[{"\<\"Outside Europe\"\>", "\[Rule]", "681"}], ",", 
   RowBox[{"\<\"Other Europe\"\>", "\[Rule]", "50"}], ",", 
   RowBox[{"\<\"Mediterranean\"\>", "\[Rule]", "486"}], ",", 
   RowBox[{"\<\"British Isles\"\>", "\[Rule]", "171"}], ",", 
   RowBox[{"\<\"Baltic\"\>", "\[Rule]", "56"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[3]=",ExpressionUUID->"8bf4934a-4754-4e8f-b8ed-4919675f5025"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
GeoListPlot[GeoPosition[{#[\"Latitude\"], #[\"Longitude\"]} & /@ samples],
 GeoRange -> {{34, 63}, {-12, 36}}, GeoProjection -> \"Equirectangular\",
 PlotStyle -> Directive[Opacity[0.45], RGBColor[0.153, 0.51, 0.64], \
PointSize[0.005]],
 GeoBackground -> GeoStyling[{\"CountryBorders\", \"Land\" -> \
GrayLevel[0.97], \"Ocean\" -> RGBColor[0.85, 0.9, 0.95]}],
 ImageSize -> 600]\
\>", "Input",
 CellLabel->"In[4]:=",ExpressionUUID->"5e04d2ec-26db-4321-b0f8-e67214351115"],

