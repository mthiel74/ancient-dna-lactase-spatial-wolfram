Cell[CellGroupData[{

Cell["3.  Regional logistic reproduction", "Section",ExpressionUUID->"edbfe7eb-be79-4022-83a6-e11794904912"],

Cell["\<\
Binomial logistic trajectories per region, fitted on every called allele \
(bins are display-only, with 95% Wilson intervals and point area proportional \
to allele count). Standard errors from the numerical Hessian; boundary hits \
are flagged.\
\>", "Text",ExpressionUUID->"32baf340-d20f-4f12-8543-a4ec7a8566e0"],

Cell[CellGroupData[{

Cell["\<\
fits = FitAllRegionalLogistics[samples];
Dataset[fits]\
\>", "Input",
 CellLabel->"In[5]:=",ExpressionUUID->"6fa21bdd-3460-495f-81f5-b742220ab8ea"],

